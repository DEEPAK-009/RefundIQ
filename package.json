{
  "name": "refundiq",
  "version": "1.0.0",
  "description": "Autonomous multimodal AI dispute-resolution and refund processing system for food delivery platforms",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "dev": "concurrently -n \"API,WORKER\" -c \"blue,magenta\" \"tsx watch src/server.ts\" \"tsx watch src/worker.ts\"",
    "dev:api": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seedOrders.ts && tsx src/db/seedPolicies.ts",
    "services:up": "docker compose up -d",
    "services:down": "docker compose down",
    "lint:no-emoji": "node scripts/checkNoEmojis.js"
  },
  "keywords": [
    "refund",
    "food-delivery",
    "ai-agent",
    "multimodal",
    "gemini",
    "pgvector",
    "bullmq",
    "guardrails"
  ],
  "author": "Deepak Reddy",
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^3.6.1",
    "bullmq": "^6.7.8",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "exifr": "^7.1.3",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "ioredis": "^6.0.0",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/sharp": "^0.31.1",
    "@types/uuid": "^10.0.0",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
