# Server Configuration
PORT=4000
NODE_ENV=development

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/refund_iq

# Cache & Background Queue (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379

# AI & Multimodal LLM (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# Evidence Storage Directory
STORAGE_DIR=./storage/uploads

# Refund Guardrail Thresholds (Configurable in INR)
MAX_AUTO_REFUND_AMOUNT=500
SUSPICIOUS_REFUND_RATE_THRESHOLD=0.3
CLAIM_WINDOW_HOURS=24

# Multi-Provider LLM Configurations
NVIDIA_API_KEY=your_nvidia_api_key_here
COHERE_API_KEY=your_cohere_api_key_here
REQUESTY_API_KEY=your_requesty_api_key_here
XKIRO_API_KEY=your_xkiro_api_key_here
LLM_EXECUTION_MODE=FALLBACK
